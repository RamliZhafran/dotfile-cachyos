#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '
alias linoffice='/home/artemis/.local/bin/linoffice/src/linoffice.sh'

. "$HOME/.local/share/../bin/env"

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/artemis/miniconda3-pbe/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/artemis/miniconda3-pbe/etc/profile.d/conda.sh" ]; then
        . "/home/artemis/miniconda3-pbe/etc/profile.d/conda.sh"
    else
        export PATH="/home/artemis/miniconda3-pbe/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

